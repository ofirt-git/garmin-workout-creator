# Google API Key for Gemini (default parsing method, free)
# Get one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic API Key for Claude AI parsing (optional, use with --method llm)
# Get one at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Garmin Connect credentials (not recommended for security)
# It's better to enter these when prompted
# GARMIN_EMAIL=your_email@example.com
# GARMIN_PASSWORD=your_password
