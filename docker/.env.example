# Docker Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration
DB_USER=garmin_admin
DB_PASSWORD=change-this-secure-password

# Security Keys
# Generate SECRET_KEY with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here

# Generate ENCRYPTION_KEY with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-here

# API Keys
GOOGLE_API_KEY=your-google-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Frontend Configuration
# For local development: http://localhost/api
# For production: https://yourdomain.com/api
FRONTEND_API_URL=http://localhost/api

# Environment
ENVIRONMENT=development
